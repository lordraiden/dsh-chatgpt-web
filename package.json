{
  "name": "@lordraiden/dsh-chatgpt-web",
  "version": "1.0.3",
  "description": "DeepSeek Harness Cordis plugin that bridges an authenticated ChatGPT Web session into DSH.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lordraiden/dsh-chatgpt-web.git"
  },
  "homepage": "https://github.com/lordraiden/dsh-chatgpt-web#readme",
  "bugs": {
    "url": "https://github.com/lordraiden/dsh-chatgpt-web/issues"
  },
  "author": "lordraiden",
  "type": "module",
  "main": "./lib/plugin.js",
  "bin": {
    "dsh-chatgpt-web": "./lib/cli.js"
  },
  "exports": {
    ".": "./lib/plugin.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "assets",
    "client.js",
    "cordis.patch.yml",
    "screenshots.json",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "build": "bun build src/cli.ts src/plugin.ts --outdir lib --target node --format esm --packages external",
    "start": "node lib/cli.js serve",
    "setup": "node lib/cli.js setup",
    "login": "node lib/cli.js login",
    "doctor": "node lib/cli.js doctor",
    "test": "node scripts/test-issue-20-settings.mjs && bun test ./scripts/test-issue-74-native-dsh.ts && bun test ./scripts/test-issue-75-authority.ts && bun test ./tests/issue-71-route-scope.test.ts && bun test ./tests/luna-think-ui.test.ts && bun test ./tests/issue-76-canonical-context.test.ts && bun test ./tests/issue-77-continuity-retry.test.ts && node scripts/smoke-tarball.mjs && bun test ./tests/issue-72-responses-provider-core.test.ts && bun test ./tests/issue-78-responses-seam.test.ts && bun test ./tests/issue-79-security-observability.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "chromium-bidi": "17.0.2",
    "fflate": "^0.8.2",
    "playwright-core": "^1.63.0",
    "tiktoken": "1.0.22",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2",
    "zod": "4.6.5",
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "@types/turndown": "5.0.5",
    "typescript": "7.0.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-llm": "~0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=22.19.0",
    "dsh": ">=0.2.0-rc.2"
  },
  "packageManager": "bun@1.4.0",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "chatgpt",
    "chatgpt-web",
    "playwright",
    "responses-api",
    "free-ai"
  ],
  "license": "MIT"
}
