# docker/Dockerfile.spike — throwaway spike for issue #245 (containerised-service track, phase 1).
#
# This is NOT the supported image. Issue #246 owns the production Dockerfile, .dockerignore, Compose
# stack, healthcheck and CI image build. This file exists to prove that the existing standalone
# sidecar can run in a container and to freeze the facts the rest of the track depends on.
# Recorded evidence, findings and open gaps: doc/container.md.

# ── base image pinning rule (do not hardcode blindly) ─────────────────────────────────────────────
# The image's browser build must match the installed playwright-core exactly, or Playwright cannot
# locate its browser executables. Derive the tag from the lockfile:
#     node -p "require('playwright-core/package.json').version"     # 1.63.0 per bun.lock
# then use mcr.microsoft.com/playwright:v<that-version>-noble (noble = Ubuntu 24.04).
# Verified in the registry on 2026-10-16 with the registry v2 API:
#     tag           mcr.microsoft.com/playwright:v1.63.0-noble
#     index digest  sha256:eff16c30e6f3f4af0a03fa4b706120d5e9b0891c344a27d64559aff5900a4a27
#     linux/amd64   sha256:bc6ab0d6d44ff4826e4cb8c1e6d801e185bfc42bb0753f8e2a30efc70db054c7
#     image config  PLAYWRIGHT_BROWSERS_PATH=/ms-playwright, no User (runs as root), Cmd /bin/bash
#     layers        7, ~911 MB
# When playwright-core is bumped, bump this tag in the same change.
FROM mcr.microsoft.com/playwright:v1.63.0-noble

# Bun is the repository's package manager and the only one that installs bun.lock reproducibly.
# It is installed inside the runtime image so no dependency built against another base is copied in.
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl ca-certificates unzip \
 && rm -rf /var/lib/apt/lists/* \
 && curl -fsSL https://bun.sh/install | bash
ENV PATH="/root/.bun/bin:${PATH}"

WORKDIR /app
COPY package.json bun.lock ./
RUN bun install --production --frozen-lockfile

# The checked-in lib/ is the runnable bundle (CI regenerates it on main); no build step is needed to
# run the sidecar. src/ and assets/ are copied because the published package ships them and the
# runtime resolves a couple of paths relative to its own directory.
COPY lib ./lib
COPY src ./src
COPY assets ./assets
COPY client.js cordis.patch.yml screenshots.json LICENSE ./

# defaultChromeExecutable() returns /usr/bin/google-chrome on Linux, which this image does not
# create (it ships browsers under PLAYWRIGHT_BROWSERS_PATH=/ms-playwright). Compute the real path
# instead of hardcoding it; this must run after the dependency install.
RUN ln -sf "$(node -p "require('playwright-core').chromium.executablePath()")" /usr/bin/google-chrome \
 && ls -l /usr/bin/google-chrome

# Data directory: config.json, the provider session state (storage-state.json + its verification
# marker) and the durable conversation store. It holds credentials — mount it, never bake it in.
ENV DSH_CHATGPT_WEB_HOME=/data
VOLUME ["/data"]
EXPOSE 17841

# The sidecar is loopback-only by construction: src/cli.ts rejects any --host other than 127.0.0.1.
# A published port alone therefore does NOT reach it (see doc/container.md, finding F1); the spike
# runs with `--network host`. It also refuses to start without a prepared /data (config.json).
CMD ["node", "lib/cli.js", "serve", "--port", "17841"]
